{
  "name": "ambassador-ap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc",
    "start": "node dist/src/server.js",
    "setup:notion": "node ./node_modules/tsx/dist/cli.mjs scripts/setup-notion.ts",
    "update:notion-summary": "node ./node_modules/tsx/dist/cli.mjs scripts/update-summary-schema.ts",
    "rebuild:yearly-tracker": "node ./node_modules/tsx/dist/cli.mjs scripts/rebuild-yearly-tracker.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@slack/web-api": "^7.8.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "luxon": "^3.6.1",
    "multer": "^2.0.2",
    "node-cron": "^4.0.7",
    "zod": "^3.25.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/luxon": "^3.6.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.18",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
